# ---------- PostgreSQL ----------
POSTGRES_DB=invernadero
POSTGRES_USER=invernadero
POSTGRES_PASSWORD=invernadero
POSTGRES_PORT=5433

# ---------- pgAdmin ----------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=invernadero
RABBITMQ_DEFAULT_PASS=invernadero
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
QUEUE_NAME=sensor.readings
MQTT_PORT=1883

# ---------- Backend API ----------
API_PORT=8000

# ---------- Frontend ----------
FRONTEND_PORT=3100
